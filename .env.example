# ============================================================
# ملف المثال — انسخه إلى Storage/.env وعبّئ القيم الحقيقية
# لا ترفع هذا الملف الحقيقي على GitHub!
# ============================================================

# Django Core
SECRET_KEY=ضع_هنا_مفتاح_سري_عشوائي_طويل_جداً_لا_يقل_عن_50_حرف
DJANGO_SETTINGS_MODULE=core.settings.local  # أو core.settings.production على السيرفر
DEBUG=False
ALLOWED_HOSTS=yoursite.com,www.yoursite.com
CSRF_TRUSTED_ORIGINS=https://yoursite.com,https://www.yoursite.com

# Database — PostgreSQL (Production)
DB_NAME=moon_db
DB_USER=moon_user
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Cloudflare R2 — Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=moon-media
AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=pub-XXXX.r2.dev

# Payment — Moyasar / Stripe
PAYMENT_PUBLIC_KEY=pk_test_...
PAYMENT_SECRET_KEY=sk_test_...

# Email — SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
